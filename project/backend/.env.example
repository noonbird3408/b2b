# =====================================================================
# 백엔드 환경변수 예시 — setup.py 가 이 값을 바탕으로 backend/.env 와 .env.vercel 을 만듭니다.
# ⚠️ .env / .env.vercel 은 절대 커밋하지 마세요(.gitignore 에 포함됨).
# Vercel 배포: 프로젝트 → Settings → Environment Variables 에 같은 이름으로 입력(또는 .env.vercel 가져오기)
# =====================================================================

# --- [필수] Supabase DB ---
# Supabase 대시보드 → 상단 Connect → Transaction pooler(포트 6543) 주소를 그대로 붙여넣고
# [YOUR-PASSWORD] 를 대괄호까지 지운 뒤 DB 비밀번호로 바꾸세요.
DATABASE_URL=postgresql://postgres.<프로젝트ID>:<DB비밀번호>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# --- [필수] Google 로그인 ---
GOOGLE_CLIENT_ID=
# 최초 관리자(원장) 등록용 초대 코드 — 12자 이상. setup.py 가 무작위로 만들어 줍니다.
ADMIN_SIGNUP_CODE=
# 직원 등록용 초대 코드 (선택, 12자 이상)
STAFF_SIGNUP_CODE=

# --- [필수] Vercel Cron 인증 (결제 대기·만료 세션 자동 정리) ---
CRON_SECRET=

# --- [선택] AI (Gemini) ---
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash

# --- [선택] 카카오페이 (비워 두면 결제 버튼만 비활성화) ---
KAKAO_SECRET_KEY=
KAKAO_CID=TC0ONETIME

# --- [선택] 외부 쇼핑몰 ---
SHOP_BASE_URL=https://ddmmall77.com
SHOP_NAME=DDM

# --- [선택] 기타 (보통 비워 둠) ---
# 기준 시간대 (기본 Asia/Seoul)
# APP_TIMEZONE=Asia/Seoul
# 사이트 주소를 강제로 지정할 때만 (비우면 접속한 주소를 자동 사용)
# BACKEND_BASE_URL=
# FRONTEND_BASE_URL=
# 과제 첨부 파일을 Supabase Storage 에 저장하려면 (비우면 임시 폴더 — Vercel 에서는 사라짐)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=assignments

# --- 로컬 미리보기 전용 (Vercel 에서는 자동으로 무시됨) ---
# Google 없이 이메일만으로 로그인 — SQLite(DATABASE_URL=sqlite:///./facility.db)일 때만 동작
# DEV_LOGIN_ENABLED=true
